generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "bun"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClassType {
  SLEEPER
  AC_3_TIER
  AC_2_TIER
  AC_1_TIER
  CHAIR_CAR
  SECOND_CLASS
}

enum JourneyStatus {
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
}

// ───────────────────────────── Models ─────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]
}

model Station {
  id    String @id @default(uuid())
  code  String @unique // e.g. "NDLS"
  name  String
  city  String
  state String?
  zone  String?

  originTrains Train[]    @relation("OriginTrains")
  destTrains   Train[]    @relation("DestTrains")
  stops        TrainStop[]
}

// The physical train: number, name, endpoints and the ordered route. It has no
// timetable of its own — departure times belong to a schedule, and a particular
// day's running belongs to a Journey. That is what lets the same train run at
// different times on different days without rewriting its route.
model Train {
  id         String   @id @default(uuid())
  number     String   @unique // e.g. "12001"
  name       String
  distanceKm Int      @default(0)
  baseFare   Int      @default(0) // paise
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  originStationId String
  destStationId   String
  originStation   Station  @relation("OriginTrains", fields: [originStationId], references: [id])
  destStation     Station  @relation("DestTrains", fields: [destStationId], references: [id])

  stops     TrainStop[]
  classes   TrainClass[]
  bookings  Booking[]
  schedules TrainSchedule[]
  journeys  Journey[]

  @@index([originStationId])
  @@index([destStationId])
}

// When a train runs, independent of what its route is.
//
// One row per weekday per run number. `validFrom`/`validTo` are how a timetable
// change is published without mutating history: close the old row's validity
// and open a new one. `departTime`/`arriveTime` are IST wall-clock strings —
// the same route can run at 06:00 on weekdays and 08:00 on Sunday.
model TrainSchedule {
  id         String    @id @default(uuid())
  trainId    String
  /// 0 = Sunday … 6 = Saturday, matching `Date.getUTCDay()`.
  dayOfWeek  Int
  /// Multiple services per day on the same route (1 = first departure).
  runNumber  Int       @default(1)
  departTime String // "06:00"
  arriveTime String // "23:00", possibly before departTime (overnight)
  validFrom  DateTime  @db.Date
  validTo    DateTime? @db.Date
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  train    Train     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  journeys Journey[]

  @@unique([trainId, dayOfWeek, runNumber])
  // Target for Journey's composite FK, so a journey cannot point at another
  // train's schedule.
  @@unique([id, trainId])
  @@index([dayOfWeek])
}

// One train, on one calendar date, from one schedule.
//
// Overnight services make this more than (trainId, date): the 21:10 departure
// from Delhi arrives in Chennai on the *next* calendar day, so `date` is the
// service date and `departureAt`/`arrivalAt` are real instants.
model Journey {
  id              String        @id @default(uuid())
  trainId         String
  trainScheduleId String
  runNumber       Int           @default(1)
  date            DateTime      @db.Date
  status          JourneyStatus @default(SCHEDULED)
  departureAt     DateTime      @db.Timestamptz(3)
  arrivalAt       DateTime      @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  train         Train         @relation(fields: [trainId], references: [id], onDelete: Cascade)
  trainSchedule TrainSchedule @relation(fields: [trainScheduleId, trainId], references: [id, trainId])
  classes       JourneyClass[]

  @@unique([trainId, date, runNumber])
  @@unique([id, trainId])
  @@index([date])
  @@index([trainId, date])
}

// Per-journey snapshot of a class's inventory and fares.
//
// A fare change or coach reallocation tomorrow must not retroactively reprice a
// journey that is already on sale, so the values are copied rather than read
// through `TrainClass` at request time.
model JourneyClass {
  id            String    @id @default(uuid())
  journeyId     String
  trainClassId  String
  classType     ClassType
  coachCount    Int
  seatsPerCoach Int
  totalSeats    Int
  baseFare      Int // paise
  farePerKm     Int // paise per km
  createdAt     DateTime  @default(now())

  journey    Journey    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  trainClass TrainClass @relation(fields: [trainClassId], references: [id])

  @@unique([journeyId, trainClassId])
  @@unique([id, journeyId])
  @@index([journeyId, classType])
}

model TrainStop {
  id         String  @id @default(uuid())
  trainId    String
  stationId  String
  stopIndex  Int
  arrival    String?
  departure  String?
  distanceKm Int     @default(0)

  train   Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])

  @@unique([trainId, stopIndex])
  @@index([stationId])
}

model TrainClass {
  id            String    @id @default(uuid())
  trainId       String
  classType     ClassType
  coachCount    Int       @default(1)
  seatsPerCoach Int       @default(80)
  totalSeats    Int
  farePerKm     Int       @default(0) // paise per km
  baseFare      Int       @default(0) // paise

  train          Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats          Seat[]
  bookingSeats   BookingSeat[]
  journeyClasses JourneyClass[]

  @@unique([trainId, classType])
}

model Seat {
  id           String  @id @default(uuid())
  trainClassId String
  coachNumber  Int
  seatNumber   Int
  isAvailable  Boolean @default(true)

  trainClass   TrainClass    @relation(fields: [trainClassId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([trainClassId, coachNumber, seatNumber])
  @@index([trainClassId, isAvailable])
}

model Booking {
  id           String        @id @default(uuid())
  pnr          String        @unique
  userId       String
  trainId      String
  travelDate   DateTime      @db.Date
  status       BookingStatus @default(PENDING)
  totalAmount  Int
  fromStopIndex Int?
  toStopIndex   Int?
  isRefundable Boolean       @default(true)
  holdExpiresAt DateTime?    @db.Timestamptz(3)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  train      Train             @relation(fields: [trainId], references: [id])
  passengers BookingPassenger[]
  seats      BookingSeat[]
  payment    Payment?

  @@index([userId])
  @@index([trainId, travelDate])
}

model BookingPassenger {
  id        String  @id @default(uuid())
  bookingId String
  name      String
  age       Int
  gender    Gender
  berthPref String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingSeat {
  id           String   @id @default(uuid())
  bookingId    String
  seatId       String
  trainClassId String
  // A physical seat is reusable across travel dates. Without this column the
  // old `@@unique([seatId])` made a seat bookable exactly once, ever.
  travelDate   DateTime @db.Date

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat       @relation(fields: [seatId], references: [id])
  trainClass TrainClass @relation(fields: [trainClassId], references: [id])

  @@unique([seatId, travelDate])
  @@index([bookingId])
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  amount         Int
  status         PaymentStatus @default(INITIATED)
  transactionId  String?       @unique
  provider       String        @default("mock")
  providerOrderId String?
  // Idempotency: retrying a payment request must not charge twice.
  idempotencyKey String?       @unique
  // Optimistic lock for webhook-driven state transitions.
  version        Int           @default(0)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]

  @@unique([provider, providerOrderId])
}

// Append-only webhook ledger. `providerEventId` is UNIQUE, so replaying a
// webhook is a no-op: INSERT ... ON CONFLICT DO NOTHING returns 0 rows and
// the handler knows the event was already processed.
model PaymentEvent {
  id              String    @id @default(uuid())
  paymentId       String
  providerEventId String?   @unique
  event           String
  payload         Json
  signature       String?
  signatureValid  Boolean   @default(false)
  processedAt     DateTime? @db.Timestamptz(3)
  error           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

// ── v2 reservation core ──────────────────────────────────────────────
// These tables are created by prisma/migrations/*_reservation_constraints.
// JourneySeat holds physical inventory only (no reservation state), so it
// can never contradict TicketSeat, which is the single source of truth for
// occupancy. `TicketSeat_no_segment_overlap` (a GiST EXCLUDE constraint)
// lives in raw SQL because Prisma cannot express it.

model JourneySeat {
  id            String   @id @default(uuid())
  journeyId     String
  coachNumber   Int
  seatNumber    Int
  isBlocked     Boolean  @default(false)
  blockedReason String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  ticketSeats TicketSeat[]

  @@unique([journeyId, coachNumber, seatNumber])
  @@index([journeyId, isBlocked])
}

model TicketSeat {
  id            String   @id @default(uuid())
  ticketId      String   @unique
  journeySeatId String
  journeyId     String
  fromStopIndex Int
  toStopIndex   Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  journeySeat JourneySeat @relation(fields: [journeySeatId], references: [id])

  @@unique([journeySeatId, fromStopIndex, toStopIndex])
  @@index([journeySeatId])
}
